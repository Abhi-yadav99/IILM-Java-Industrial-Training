class Solution {
    public ListNode deleteMiddle(ListNode head) {
        if(head == null || head.next == null) return null;
        ListNode Slow = head;
        ListNode Fast = head;
        ListNode temp = null;
        while(Fast !=null && Fast.next !=null){
            temp = Slow;
            Slow = Slow.next;
            Fast = Fast.next.next;
        }
        temp.next = Slow.next;
        return head;
    }
}
