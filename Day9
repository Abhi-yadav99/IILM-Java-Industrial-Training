class Solution {
    public int maxArea(int[] height){
        int maxArea=0;
        for(int i=0; i<height.length;++i){
            for(int j=height.length-1; j>0; --j){
                int length=Math.min(height[i],height[j]);
                int width =j-i;
                int current_Area=length*width;
                maxArea=Math.max(maxArea,current_Area);
            }
        }
        return maxArea;
     }
}
